OLLAMA_BASE_URL=http://127.0.0.1:11434
CHAT_MODEL=qwen3:4b-instruct
EMBED_MODEL=qwen3-embedding:0.6b
CHAT_CONTEXT_TURNS=3

# MySQL local trong ServBay
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=ai_4gym
DATABASE_USER=root
DATABASE_PASSWORD=change_me

# false khi chạy HTTP local; đặt true nếu triển khai qua HTTPS
COOKIE_SECURE=false

# Giới hạn tần suất đăng nhập/đăng ký/chat; chỉ đặt false khi chạy kiểm thử tự động
RATE_LIMIT_ENABLED=true
